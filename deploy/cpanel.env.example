# Sao chép thành deploy/cpanel.env (file .env đã nằm trong .gitignore nếu đặt ở root).
# Chỉ dùng ghi chú local — KHÔNG commit mật khẩu FTP/SSH.

CPANEL_USER=your_cpanel_username
WP_ROOT=/home/your_cpanel_username/public_html
THEME_PATH=/home/your_cpanel_username/public_html/wp-content/themes/generatepress_child
GIT_REPO=https://github.com/minhthangdev93/annam.git
SITE_URL=https://annamdiscovery.com
